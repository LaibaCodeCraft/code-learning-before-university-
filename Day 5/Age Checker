#include <iostream>
using namespace std;
int main() {
   int age;
   cout <<"Enter the age:";
   cin >> age; 
if (age>=18) {
   cout <<"You are an Adult";
}
else if (age>=13) {
   cout <<"You are a Teenager";
}
else if (age>=5) {
   cout <<"You are a Child";
}
else if (age>=1) {
   cout <<"You are a Baby";
}
else {
   cout <<"Invalid Age";
}
return 0;
}
